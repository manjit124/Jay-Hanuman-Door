# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ADMIN_PASSWORD: Password for the door business admin portal (default: admin123)
ADMIN_PASSWORD="admin123"

# FIREBASE CLOUD MESSAGING (FCM) - OPTIONAL PUSH NOTIFICATIONS (Server-Side Only)
# Only needed if enabling server-side push notification delivery:
# FIREBASE_PROJECT_ID="your-firebase-project-id"
# FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxxxx@your-firebase-project-id.iam.gserviceaccount.com"
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# Optional Web Push VAPID Key:
# VITE_FIREBASE_VAPID_KEY="BN_YOUR_PUBLIC_VAPID_KEY_FROM_FIREBASE_CONSOLE"

# CLIENT FIREBASE CONFIG: Already bundled in firebase-applet-config.json (no action required)

# BUNNY.NET STORAGE (Server-Side Only — NEVER expose password to client/APK)
# BUNNY_STORAGE_ZONE="jai-hanuman-door-media"
# BUNNY_STORAGE_PASSWORD="YOUR_BUNNY_STORAGE_PASSWORD"
# BUNNY_STORAGE_ENDPOINT="https://sg.storage.bunnycdn.com/jai-hanuman-door-media"
# Optional Pull Zone public CDN hostname (e.g. https://jai-hanuman-door-media.b-cdn.net):
# BUNNY_CDN_URL=""

# GOOGLE DRIVE CENTRAL MEDIA STORAGE (Optional Server-Side Only — NEVER expose to client/APK)
# Can also be connected interactively via Admin Panel -> Cloud Storage
# GOOGLE_DRIVE_CLIENT_ID="your_google_oauth_client_id.apps.googleusercontent.com"
# GOOGLE_DRIVE_CLIENT_SECRET="your_google_oauth_client_secret"
# GOOGLE_DRIVE_REFRESH_TOKEN="your_google_oauth_refresh_token"

# LEGACY READ-ONLY CLOUDFLARE R2 (Historical read-only fallback only; active storage is Bunny.net Storage)
# R2_ACCOUNT_ID=""
# R2_ACCESS_KEY_ID=""
# R2_SECRET_ACCESS_KEY=""
# R2_BUCKET_NAME="jai-hanuman-door-media"

# SMS OTP PROVIDER - APITXT (Server-Side Only — NEVER expose to frontend)
APITXT_API_KEY=

# RAZORPAY ONLINE PAYMENTS (Server-Side Only — NEVER expose secrets to frontend)
# Mode defaults to "test". Do not switch to "live" until verified live keys are set.
RAZORPAY_MODE=test
RAZORPAY_TEST_KEY_ID=
RAZORPAY_TEST_KEY_SECRET=
RAZORPAY_LIVE_KEY_ID=
RAZORPAY_LIVE_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# GOOGLE PLAY BILLING SUBSCRIPTION VERIFICATION (Server-Side Only — NEVER expose to frontend/APK)
# Required to verify JHD_ADFREE_MONTHLY (₹49/mo) & JHD_ADFREE_YEARLY (₹399/yr) via Google Play Developer API
GOOGLE_PLAY_PACKAGE_NAME="com.doorstudio.ai"
# Provide either GOOGLE_PLAY_SERVICE_ACCOUNT_JSON (full JSON string) OR CLIENT_EMAIL + PRIVATE_KEY:
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
GOOGLE_PLAY_CLIENT_EMAIL=
GOOGLE_PLAY_PRIVATE_KEY=
# Shared verification token for Google Play Real-Time Developer Notifications (Pub/Sub push webhook)
GOOGLE_PLAY_RTDN_TOKEN=

# GOOGLE ADMOB CONFIGURATION (Optional env defaults; also configurable in Admin Panel -> Google AdMob)
# Defaults safely to Google's official test Ad Unit IDs in test mode.
ADMOB_APP_ID=
ADMOB_BANNER_UNIT_ID=
ADMOB_INTERSTITIAL_UNIT_ID=
ADMOB_REWARDED_UNIT_ID=
