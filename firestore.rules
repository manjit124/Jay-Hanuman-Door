rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isAdmin() {
      return isAuthenticated() &&
             request.auth.token.keys().hasAll(['email']) &&
             (
               request.auth.token.email.toLowerCase() in [
                 'shivshahidoors@gmail.com',
                 'jayhanumandoor@gmail.com',
                 'jaihanumandoor@gmail.com',
                 'orders@jaihanumandoor.com',
                 'admin@jaihanumandoor.com',
                 'admin@shivshahidoors.com'
               ] ||
               request.auth.token.email.matches('.*@jaihanumandoor\\.com$') ||
               request.auth.token.email.matches('.*@shivshahidoors\\.com$') ||
               (request.auth.token.keys().hasAll(['admin']) && request.auth.token.admin == true)
             );
    }

    // Master store document
    match /admin_store/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Door catalog collection
    match /doors/{doorId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Materials pricing collection
    match /materials/{materialId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Home banners collection
    match /banners/{bannerId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Business settings collection
    match /settings/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Media uploads collection
    match /media_files/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Default catch-all fallback rule
    match /{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}



