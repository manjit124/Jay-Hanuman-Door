rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isAdmin() {
      return isAuthenticated() &&
             (
               (
                 'email' in request.auth.token &&
                 request.auth.token.email != null &&
                 (
                   request.auth.token.email in [
                     'shivshahidoors@gmail.com',
                     'jayhanumandoor@gmail.com',
                     'jaihanumandoor@gmail.com',
                     'orders@jaihanumandoor.com',
                     'admin@jaihanumandoor.com',
                     'admin@shivshahidoors.com'
                   ] ||
                   request.auth.token.email.lower() in [
                     'shivshahidoors@gmail.com',
                     'jayhanumandoor@gmail.com',
                     'jaihanumandoor@gmail.com',
                     'orders@jaihanumandoor.com',
                     'admin@jaihanumandoor.com',
                     'admin@shivshahidoors.com'
                   ] ||
                   request.auth.token.email.lower().matches('.*@jaihanumandoor\\.com$') ||
                   request.auth.token.email.lower().matches('.*@shivshahidoors\\.com$')
                 )
               ) ||
               ('admin' in request.auth.token && request.auth.token.admin == true)
             );
    }

    // Master store document
    match /admin_store/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Door catalog collection
    match /doors/{doorId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Materials pricing collection
    match /materials/{materialId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Finishes pricing collection
    match /finishes/{finishId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Chaukhat frames collection
    match /frames/{frameId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Hardware items collection
    match /hardware/{hardwareId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Home banners collection
    match /banners/{bannerId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Articles collection
    match /articles/{articleId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Business settings collection
    match /settings/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Media uploads collections
    match /media_files/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /uploaded_media/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /uploaded_media_chunks/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Default catch-all fallback rule
    match /{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}



